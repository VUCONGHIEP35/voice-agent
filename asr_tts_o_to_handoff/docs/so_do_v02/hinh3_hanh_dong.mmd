flowchart TD
    %% Hình 3 - Sơ đồ tầng hành động (đề cương v0.2)
    SRC1(["Lệnh JSON từ Edge<br/>đã ràng buộc GBNF"])
    SRC2(["Lệnh JSON từ Cloud<br/>chưa chắc được ràng buộc"])
    SRC3(["Lệnh đề xuất chủ động<br/>sự kiện từ bộ giả lập + bảng luật"])
    SV{"Đúng schema?<br/>Phụ lục A"}
    BAD(["Loại lệnh<br/>+ báo lỗi qua TTS"])
    ST[("Trạng thái xe hiện tại<br/>tốc độ · cửa · môi trường")]
    RULES[("Bảng luật / chính sách<br/>file cấu hình")]
    G{"CỔNG AN TOÀN<br/>phạm vi giá trị<br/>luật theo trạng thái xe<br/>→ phân bậc rủi ro"}
